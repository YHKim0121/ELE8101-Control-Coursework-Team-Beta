plt.figure(figsize=(10, 4))
plt.plot(t_axis[:-1], bias_err[:, 0], label='b1 error')
plt.plot(t_axis[:-1], bias_err[:, 1], label='b2 error')
plt.plot(t_axis[:-1], bias_err[:, 2], label='b3 error')
plt.xlabel('Time [s]')
