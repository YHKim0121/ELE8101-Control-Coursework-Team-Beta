import numpy as np
import matplotlib.pyplot as plt

np.random.seed(0)

# --- 1. PROBLEM DATA & PARAMETERS ---
h = 0.01                # 100 Hz measurement frequency
Q_val = 0.01            # Process noise (speed wobble)
R_var = 1.5**2          # Sensor noise variance (1.5m standard dev)
R_track = 50.0          # Radius of the circular track

# The "Triangle Strategy": Beacons placed safely outside the track
beacons = np.array([[-60.0, 60.0],   # Beacon 1: Top-Left
                    [-60.0, -60.0],  # Beacon 2: Bottom-Left
                    [130.0, 0.0]])   # Beacon 3: Far Right

A = np.array([[1, h], 
              [0, 1]])
G = np.array([[0], 
              [1]])

# Initial guesses: Position = 0, Velocity = 10 m/s
x0_tilde = np.array([[0], [10.0]]) 
P0 = np.array([[100, 0], [0, 1]])

# --- 2. EKF FUNCTIONS ---
def time_update(sigma_mu, x_mu):
    x_tu = A @ x_mu
    sigma_tu = A @ sigma_mu @ A.T + Q_val * (G @ G.T)
    return sigma_tu, x_tu

def measurement_update_ekf(sigma_tu, x_tu, y_meas, beacon):
    """The EKF Correction using the Jacobian (The Straightener)"""
    s = x_tu[0, 0] # Current estimated distance along the track
    
    # 1. Translate track distance to X, Y coordinates
    px = R_track * np.cos(s / R_track)
    py = R_track * np.sin(s / R_track)
    
    # 2. Predict the distance to this specific beacon
    dx = px - beacon[0]
    dy = py - beacon[1]
    dist_pred = np.sqrt(dx**2 + dy**2)
    
    # 3. Calculate the Jacobian (H matrix)
    ds_dx = -np.sin(s / R_track)
    ds_dy = np.cos(s / R_track)
    H1 = (dx * ds_dx + dy * ds_dy) / dist_pred
    H = np.array([[H1, 0.0]])
    
    # 4. Standard Kalman Update Math
    z = H @ sigma_tu @ H.T + R_var
    K = sigma_tu @ H.T @ np.linalg.inv(z)
    
    # Update state and uncertainty
    x_mu = x_tu + K @ (y_meas - dist_pred) 
    sigma_mu = sigma_tu - K @ H @ sigma_tu
    
    return sigma_mu, x_mu

# --- 3. RUNNING THE SIMULATION ---
n_sim = 5000
x_true = x0_tilde.copy()
sigma_tu, x_tu = P0, x0_tilde.copy()

# Storage arrays
x_cache = np.zeros((n_sim, 2))
x_mu_cache = np.zeros((n_sim, 2))
sigma_p_cache = np.zeros(n_sim)
sigma_v_cache = np.zeros(n_sim)
true_xy = np.zeros((n_sim, 2))
est_xy = np.zeros((n_sim, 2))

for t in range(n_sim):
    # A. Reality: Car moves
    w = np.random.normal(0, np.sqrt(Q_val))
    x_true = A @ x_true + G * w
    x_cache[t, :] = x_true.T
    
    # Save true X, Y for the map
    true_xy[t, 0] = R_track * np.cos(x_true[0,0] / R_track)
    true_xy[t, 1] = R_track * np.sin(x_true[0,0] / R_track)
    
    # B. Correction Phase (Process all 3 beacons)
    sigma_mu, x_mu = sigma_tu, x_tu # Start with our prediction
    for b in beacons:
        # Generate noisy sensor reading
        true_dist = np.sqrt((true_xy[t, 0] - b[0])**2 + (true_xy[t, 1] - b[1])**2)
        y_meas = np.array([[true_dist + np.random.normal(0, np.sqrt(R_var))]])
        
        # Apply EKF update
        sigma_mu, x_mu = measurement_update_ekf(sigma_mu, x_mu, y_meas, b)
        
    # Save estimates
    x_mu_cache[t, :] = x_mu.T
    sigma_p_cache[t] = np.sqrt(sigma_mu[0, 0])
    sigma_v_cache[t] = np.sqrt(sigma_mu[1, 1])
    est_xy[t, 0] = R_track * np.cos(x_mu[0,0] / R_track)
    est_xy[t, 1] = R_track * np.sin(x_mu[0,0] / R_track)
    
    # C. Prediction Phase for next step
    sigma_tu, x_tu = time_update(sigma_mu, x_mu)

t_axis = np.arange(n_sim) * h


# --- 4. THE PLOTS ---
# Plot 1: The Track Map
plt.figure(figsize=(7, 6))
plt.plot(true_xy[:, 0], true_xy[:, 1], 'g-', label='True Circular Path', linewidth=2)
plt.plot(est_xy[:, 0], est_xy[:, 1], 'b--', label='EKF Estimated Path')
plt.scatter(beacons[:,0], beacons[:,1], c='red', marker='^', s=150, label='Beacons')
plt.title("Track Map with Triangle Beacon Strategy")
plt.xlabel("X Position [m]")
plt.ylabel("Y Position [m]")
plt.legend()
plt.axis('equal')
plt.grid(True)
plt.show()

# Plot 2: Error Analysis (Using your subplot style)
fig, axs = plt.subplots(2, 1, figsize=(8, 6))

# Position error 
axs[0].plot(t_axis, x_cache[:, 0] - x_mu_cache[:, 0], 'g-', label='Position error')
axs[0].plot(t_axis,  3*sigma_p_cache, 'r--', label=r'$\pm 3\sigma$')
axs[0].plot(t_axis, -3*sigma_p_cache, 'r--')
axs[0].axhline(0, color='k', linewidth=0.5)
axs[0].set_xlabel('Time, $t$ [s]')
axs[0].set_ylabel('Position error [m]')
axs[0].legend()
axs[0].grid(True, alpha=0.3)

# Velocity error 
axs[1].plot(t_axis, x_cache[:, 1] - x_mu_cache[:, 1], 'g-', label='Velocity error')
axs[1].plot(t_axis,  3*sigma_v_cache, 'r--', label=r'$\pm 3\sigma$')
axs[1].plot(t_axis, -3*sigma_v_cache, 'r--')
axs[1].axhline(0, color='k', linewidth=0.5)
axs[1].set_xlabel('Time, $t$ [s]')
axs[1].set_ylabel('Velocity error [m/s]')
axs[1].legend()
axs[1].grid(True, alpha=0.3)

plt.tight_layout()
plt.show()